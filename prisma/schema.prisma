generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Auth.js models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  symptoms           Symptom[]
  medications        Medication[]
  predefinedSymptoms PredefinedSymptom[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application models ---

model Symptom {
  id         String   @id @default(cuid())
  name       String
  intensity  Int      // 1 à 10
  notes      String?
  occurredAt DateTime // date/heure du symptôme (saisie ou passée)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([name])
  @@index([userId])
}

model PredefinedSymptom {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@index([userId])
}

model Medication {
  id        String          @id @default(cuid())
  name      String
  dosage    Int             // posologie en mg
  time      String          // heure de prise quotidienne (format "HH:mm")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      MedicationLog[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MedicationLog {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt      DateTime   // heure réelle de prise
  scheduledAt  DateTime   // heure prévue ce jour-là
  deltaMinutes Int        // décalage en minutes vs heure prévue (0 = à l'heure)
  date         String     // date du jour (YYYY-MM-DD) pour requêtes faciles
  createdAt    DateTime   @default(now())

  @@unique([medicationId, date])
  @@index([date])
  @@index([medicationId])
}
