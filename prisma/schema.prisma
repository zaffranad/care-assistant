generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Symptom {
  id         String   @id @default(cuid())
  name       String
  intensity  Int      // 1 à 10
  notes      String?
  occurredAt DateTime // date/heure du symptôme (saisie ou passée)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([occurredAt])
  @@index([name])
}

model PredefinedSymptom {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Medication {
  id        String          @id @default(cuid())
  name      String
  dosage    Int             // posologie en mg
  time      String          // heure de prise quotidienne (format "HH:mm")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      MedicationLog[]
}

model MedicationLog {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt      DateTime   // heure réelle de prise
  scheduledAt  DateTime   // heure prévue ce jour-là
  deltaMinutes Int        // décalage en minutes vs heure prévue (0 = à l'heure)
  date         String     // date du jour (YYYY-MM-DD) pour requêtes faciles
  createdAt    DateTime   @default(now())

  @@unique([medicationId, date])
  @@index([date])
  @@index([medicationId])
}
